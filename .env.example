# OpenAI API key — leave blank to use mock AI summaries locally
OPENAI_API_KEY=

# Database URL
#   Local dev (SQLite):  sqlite:///./loglens.db
#   Render Postgres:     postgresql://user:pass@host:5432/dbname
#   (Render's DATABASE_URL env var is auto-injected when you link a DB to the service)
DATABASE_URL=sqlite:///./loglens.db

# Comma-separated origins allowed for CORS
#   Local dev:    http://localhost:5173,http://localhost:3000
#   Production:   https://your-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
